{
  "name": "barberbro-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "test": "echo \"No backend tests configured\" && exit 0",
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup-db": "node setup-db.js",
    "build:admin": "cd admin-web && npm install && npm run build",
    "build:customer": "cd customer-app && npm install && npm run build",
    "build:all": "npm run build:admin && npm run build:customer",
    "start:prod": "node server.js"
  },
  "keywords": ["barbershop", "loyalty", "api", "admin"],
  "author": "",
  "license": "ISC",
  "description": "BarberBro API and admin/customer portals",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^6.9.16",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
